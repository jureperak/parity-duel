{
  "name": "teams-even-odd",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "sync-server": "azure-local-service",
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "powershell -NoProfile -Command \"Compress-Archive appPackage/* even-odd.zip -Force\"",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.23.0",
    "@fluidframework/azure-client": "^1.2.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@microsoft/live-share": "^1.4.2",
    "@microsoft/teams-js": "^2.57.0",
    "fluid-framework": "^1.4.0",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluidframework/azure-local-service": "^1.2.0",
    "@fluidframework/test-client-utils": "^1.4.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
