# All optional. Copy to .env for local builds, or set as repository variables for CI
# (Settings → Secrets and variables → Actions → Variables).

# TURN relay, needed for players on strict networks (mobile data, some routers,
# company networks). Comma-separated turn:/turns: URLs plus credentials.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Self-hosted PeerJS signaling server. Empty = the public PeerJS cloud.
VITE_PEERJS_HOST=
VITE_PEERJS_PORT=
VITE_PEERJS_PATH=
VITE_PEERJS_SECURE=

# PeerJS log level 0-3 (3 = log every connection step).
VITE_PEERJS_DEBUG=

# Entra app registration used to show Teams profile photos (Teams mode only).
VITE_ENTRA_CLIENT_ID=
